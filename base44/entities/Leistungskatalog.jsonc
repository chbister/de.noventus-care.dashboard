{
  "name": "Leistungskatalog",
  "type": "object",
  "properties": {
    "leistungs_id": {
      "type": "string",
      "description": "Eindeutige Leistungs-ID (z.B. REIN-01)"
    },
    "bezeichnung": {
      "type": "string",
      "description": "Leistungsbeschreibung"
    },
    "einheit": {
      "type": "string",
      "enum": [
        "Stunde",
        "St\u00fcck",
        "Monatspauschale",
        "Tag",
        "Pauschal"
      ],
      "description": "Abrechnungseinheit"
    },
    "netto_preis": {
      "type": "number",
      "default": 0,
      "description": "Nettopreis in EUR"
    },
    "umsatzsteuer_satz": {
      "type": "number",
      "enum": [
        0,
        7,
        19
      ],
      "default": 19,
      "description": "Umsatzsteuersatz in %"
    },
    "kategorie": {
      "type": "string",
      "enum": [
        "Reinigung",
        "Begleitung",
        "Service",
        "Pflege",
        "Sonstiges"
      ],
      "description": "Leistungskategorie"
    }
  },
  "required": [
    "leistungs_id",
    "bezeichnung",
    "einheit",
    "netto_preis"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}