{
  "name": "BelegungsSnapshot",
  "type": "object",
  "properties": {
    "einrichtung_id": {
      "type": "string",
      "description": "Zugeh\u00f6rige Einrichtung (ID)"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "wohnbereich_name": {
      "type": "string"
    },
    "bereich_typ": {
      "type": "string",
      "enum": [
        "station\u00e4r",
        "tagespflege"
      ],
      "default": "station\u00e4r"
    },
    "belegung_ruestige": {
      "type": "number",
      "default": 0
    },
    "belegung_pg0": {
      "type": "number",
      "default": 0
    },
    "belegung_pg1": {
      "type": "number",
      "default": 0
    },
    "belegung_pg2": {
      "type": "number",
      "default": 0
    },
    "belegung_pg3": {
      "type": "number",
      "default": 0
    },
    "belegung_pg4": {
      "type": "number",
      "default": 0
    },
    "belegung_pg5": {
      "type": "number",
      "default": 0
    },
    "gesamt": {
      "type": "number",
      "default": 0
    },
    "sollbelegung": {
      "type": "number",
      "default": 0
    },
    "bemerkung": {
      "type": "string"
    }
  },
  "required": [
    "datum",
    "wohnbereich_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.einrichtung_id": {
            "$in": "{{user.data.erlaubte_einrichtungen}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.einrichtung_id": {
            "$in": "{{user.data.erlaubte_einrichtungen}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.einrichtung_id": {
            "$in": "{{user.data.erlaubte_einrichtungen}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}