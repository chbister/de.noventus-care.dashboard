{
  "name": "BetreutesWohnenWahlleistungen",
  "type": "object",
  "properties": {
    "datum": {
      "type": "string",
      "format": "date",
      "description": "Datum der Leistung"
    },
    "wohneinheit_id": {
      "type": "string",
      "description": "Wohneinheit-ID"
    },
    "leistungs_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung zu Leistungskatalog"
    },
    "menge": {
      "type": "number",
      "default": 1,
      "description": "Menge/Stunden"
    },
    "netto_betrag": {
      "type": "number",
      "default": 0,
      "description": "Netto-Betrag in EUR"
    },
    "bemerkung": {
      "type": "string",
      "description": "Notiz zur Leistung"
    }
  },
  "required": [
    "datum",
    "wohneinheit_id",
    "leistungs_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}