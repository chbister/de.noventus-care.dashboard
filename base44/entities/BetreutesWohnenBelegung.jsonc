{
  "name": "BetreutesWohnenBelegung",
  "type": "object",
  "properties": {
    "wohneinheit_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung zu WohneinheitenStamm"
    },
    "mieter_id": {
      "type": "string",
      "description": "Anonymisierte oder Klienten-ID"
    },
    "mieter_name": {
      "type": "string",
      "description": "Name des Mieters"
    },
    "einzug_datum": {
      "type": "string",
      "format": "date",
      "description": "Einzugsdatum"
    },
    "auszug_datum": {
      "type": "string",
      "format": "date",
      "description": "Auszugsdatum (leer bei aktiven Mietern)"
    },
    "pflegegrad": {
      "type": "string",
      "enum": [
        "PG 1",
        "PG 2",
        "PG 3",
        "PG 4",
        "PG 5",
        "Ohne PG"
      ],
      "description": "Pflegegrad"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktiv",
        "Ausgezogen",
        "Reserviert"
      ],
      "default": "Aktiv",
      "description": "Belegungsstatus"
    }
  },
  "required": [
    "wohneinheit_id",
    "einzug_datum"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}